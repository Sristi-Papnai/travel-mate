            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "User ID"
              },
              "firstName": {
                "type": "string",
                "description": "First name"
              },
              "lastName": {
                "type": "string",
                "description": "Last name"
              },
              "email": {
                "type": "string",
                "description": "Email"
              }
            },
            "required": [
              "id",
              "firstName",
              "lastName",
              "email"
            ],
            "nullable": true
          }
        },
        "required": [
          "success",
          "msg"
        ]
      }
    },
